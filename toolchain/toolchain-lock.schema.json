{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://webman-aot.example/schema/toolchain-lock-v1.json",
    "title": "Webman AOT toolchain lock",
    "type": "object",
    "required": [
        "schema",
        "target",
        "hosts",
        "components",
        "embeddedLibraries",
        "requiredExtensions",
        "evidence"
    ],
    "properties": {
        "schema": {
            "const": "webman-aot-toolchain-lock-v1"
        },
        "target": {
            "type": "object",
            "required": [
                "os",
                "architecture",
                "libc",
                "minimumKernel"
            ]
        },
        "hosts": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
                "type": "string"
            }
        },
        "components": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/component"
            }
        },
        "embeddedLibraries": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/embeddedLibrary"
            }
        },
        "requiredExtensions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "string"
                }
            }
        },
        "evidence": {
            "type": "object"
        }
    },
    "$defs": {
        "component": {
            "type": "object",
            "required": [
                "id",
                "kind",
                "version",
                "sourceUrl",
                "sha256"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "kind": {
                    "type": "string"
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "sourceUrl": {
                    "type": "string",
                    "pattern": "^https://"
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        },
        "embeddedLibrary": {
            "type": "object",
            "required": [
                "id",
                "version",
                "sourceUrl",
                "recipeRevision",
                "coveredBy",
                "artifactSha256"
            ]
        }
    }
}

