{
    "name": "webman-aot/webman-aot",
    "description": "Global CLI toolchain for reproducible fully static Webman AOT builds",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4 <8.6"
    },
    "autoload": {
        "psr-4": {
            "WebmanAot\\": "src/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php",
        "toolchain:self-check": "@php tools/toolchain.php self-check"
    },
    "config": {
        "sort-packages": true
    }
}

