{
  "name": "supdger/webman-aot-builder",
  "description": "Composer entry point for Webman AOT Builder; platform runtime is prepared separately",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "bin": [
    "packages/composer-installer/bin/webman-aot"
  ],
  "autoload": {
    "psr-4": {
      "Supdger\\WebmanAotInstaller\\": "packages/composer-installer/src/"
    }
  },
  "scripts": {
    "test": "@php packages/composer-installer/tests/run.php"
  },
  "archive": {
    "exclude": [
      "/.git",
      "/.gitattributes",
      "/.github/",
      "/.gitignore",
      "/CHANGELOG.md",
      "/NOTICE.md",
      "/bin/",
      "/build.cmd",
      "/build.command",
      "/compatibility/",
      "/docs/",
      "/installer/",
      "/openspec/",
      "/scripts/",
      "/src/",
      "/tests/",
      "/toolchain/",
      "/toolchain.lock.json",
      "/tools/",
      "/packages/composer-installer/tests/",
      "/packages/composer-installer/README.md",
      "/packages/composer-installer/LICENSE"
    ]
  },
  "homepage": "https://github.com/supdger/webman-aot-builder",
  "support": {
    "issues": "https://github.com/supdger/webman-aot-builder/issues",
    "docs": "https://github.com/supdger/webman-aot-builder/wiki/Install"
  },
  "dist": {
    "type": "zip",
    "url": "https://github.com/supdger/webman-aot-builder/releases/download/v0.3.6/webman-aot-builder-0.3.6-composer.zip"
  }
}
